{
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --host lan --port 8081 --clear",
    "start:lan:reset": "EXPO_PUBLIC_RESET_LOCAL_DATA=1 expo start --host lan --port 8081 --clear",
    "start:tunnel": "expo start --tunnel --clear",
    "start:tunnel:reset": "EXPO_PUBLIC_RESET_LOCAL_DATA=1 expo start --tunnel --clear",
    "stop:metro": "lsof -ti tcp:8081 | xargs kill",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-font": "~14.0.11",
    "expo-status-bar": "latest",
    "react": "^19.1.0",
    "react-native": "^0.81.4"
  },
  "devDependencies": {
    "@types/react": "latest",
    "typescript": "latest"
  },
  "private": true,
  "name": "calos",
  "version": "1.0.0",
  "main": "index.js"
}
